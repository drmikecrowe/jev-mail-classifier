[Unit]
Description=jev-mail: classify new mail with Jev, once

[Service]
Type=oneshot
# Optional ("-"): secrets for a headless run when they do not live in .env, for example when a password manager supplies them.
EnvironmentFile=-%h/.local/share/jev-mail/env
# Change this path if the repository is not at ~/jev-mail-classifier.
ExecStart=%h/jev-mail-classifier/jev-mail run
